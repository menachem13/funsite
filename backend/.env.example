# Local dev: your own Postgres. In production: your Supabase project's
# Session pooler connection string (Project Settings → Database → Connect →
# Connection string → "Session pooler" tab — NOT "Direct connection", which
# is IPv6-only and won't reach from hosts like Render that lack outbound
# IPv6, and NOT "Transaction pooler", which restricts features this
# long-running server relies on).
DATABASE_URL=postgres://user:password@localhost:5432/funall
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# Admin login: fixed username + one-time code emailed on request — there's
# no admin self-registration. Pick your own username; ADMIN_OTP_EMAILS is a
# comma-separated list (the code goes to all of them, any one can complete
# login). Leave both unset and the admin/* auth routes just 503 — the rest
# of the app runs fine without an admin configured.
ADMIN_USERNAME=change-this-to-a-real-admin-username
ADMIN_OTP_EMAILS=you@example.com,co-admin@example.com

# Optional — without these, OTP codes are only logged to the server console
# (see services/mailer.js), which is fine for local dev/testing but not for
# a real deployment. Set these to actually email the code.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Funall <noreply@yourdomain.com>

# Listing photo/video storage (Supabase Storage). REQUIRED when NODE_ENV=
# production — Render's local disk does not persist across redeploys, so
# without these, every redeploy wipes every listing's photos. Not required
# for local dev: without them the server just writes to ./uploads instead.
# SUPABASE_URL is the same project's URL as your DATABASE_URL (Project
# Settings → API → Project URL). SUPABASE_SERVICE_ROLE_KEY is the "service_role"
# secret key on that same page — NOT the "anon" public key; it grants full
# read/write on storage and must never be exposed to the frontend or committed.
# SUPABASE_STORAGE_BUCKET must exist already and be set to a public bucket
# (Storage → Create bucket → check "Public bucket"); the app does not create it.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# SUPABASE_STORAGE_BUCKET=listing-media
