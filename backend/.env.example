# Local dev: your own Postgres. In production: your Supabase project's
# Session pooler connection string (Project Settings → Database → Connect →
# Connection string → "Session pooler" tab — NOT "Direct connection", which
# is IPv6-only and won't reach from hosts like Render that lack outbound
# IPv6, and NOT "Transaction pooler", which restricts features this
# long-running server relies on).
DATABASE_URL=postgres://user:password@localhost:5432/funsite
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# Admin login: fixed username + one-time code emailed on request — there's
# no admin self-registration. Pick your own username; ADMIN_OTP_EMAILS is a
# comma-separated list (the code goes to all of them, any one can complete
# login). Leave both unset and the admin/* auth routes just 503 — the rest
# of the app runs fine without an admin configured.
ADMIN_USERNAME=change-this-to-a-real-admin-username
ADMIN_OTP_EMAILS=you@example.com,co-admin@example.com

# Optional — without these, OTP codes are only logged to the server console
# (see services/mailer.js), which is fine for local dev/testing but not for
# a real deployment. Set these to actually email the code.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Funsite <noreply@yourdomain.com>
